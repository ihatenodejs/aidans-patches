        <span>Add to Morphe</span>
      </GlowButton>
      <GlowButton
        variant="github"
        href="https://github.com/ihatenodejs/aidans-patches"
      >
        <GitHubIcon class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" />
        <span>View Source</span>
      </GlowButton>
