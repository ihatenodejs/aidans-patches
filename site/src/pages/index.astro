---
import AppIcon from '../components/AppIcon.astro';
import CommitScopeBadge from '../components/CommitScopeBadge.astro';
import CommitTypeBadge from '../components/CommitTypeBadge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsStrip from '../components/StatsStrip.astro';
import AppPreviewCard from '../components/AppPreviewCard.astro';
import ViewMoreAppsCard from '../components/ViewMoreAppsCard.astro';
import BentoCard from '../components/BentoCard.astro';
import MockConfig from '../components/MockConfig.astro';
import PatchCodeViewer from '../components/PatchCodeViewer.astro';
import GridLine from '../components/GridLine.astro';
import DeveloperMenuCard from '../components/DeveloperMenuCard.astro';
import GlowButton from '../components/GlowButton.astro';
import MorpheIcon from '../components/icons/MorpheIcon.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import DownloadIcon from '../components/icons/DownloadIcon.astro';
import {
  getApps,
  getInitialVersionStatuses,
  getLatestRelease,
  getPatches,
  getRepositoryStats,
} from '../data/repo';

const apps = getApps();
const totalPatches = getRepositoryStats().totalPatchesCount;
const latestRelease = getLatestRelease();
const versionStatuses = getInitialVersionStatuses().slice(0, 4);
const developerPatchCount = getPatches().filter(
  (patch) => patch.category === 'Developer',
).length;
const trackerProviders = [
  { name: 'Amplitude', packages: ['com.sidelineswap.android'] },
  { name: 'AppLovin MAX', packages: ['com.sezzle.sezzlemobile'] },
  {
    name: 'AppsFlyer',
    packages: ['com.sezzle.sezzlemobile', 'com.tripledot.blackjack'],
  },
  { name: 'Braze', packages: ['com.sezzle.sezzlemobile'] },
  {
    name: 'Firebase Analytics',
    packages: [
      'com.avinside',
      'com.sezzle.sezzlemobile',
      'com.sidelineswap.android',
      'com.groundspeak.geocaching.intro',
      'com.aftership.AfterShip',
      'com.tripledot.blackjack',
      'com.nhl.gc1112.free',
    ],
  },
  { name: 'FullStory', packages: ['com.sezzle.sezzlemobile'] },
  {
    name: 'Facebook SDK',
    packages: [
      'com.sezzle.sezzlemobile',
      'com.sidelineswap.android',
      'com.groundspeak.geocaching.intro',
    ],
  },
  {
    name: 'Google AAID',
    packages: [
      'com.sezzle.sezzlemobile',
      'com.sidelineswap.android',
      'com.groundspeak.geocaching.intro',
      'com.aftership.AfterShip',
      'com.nhl.gc1112.free',
    ],
  },
  { name: 'mParticle', packages: ['com.sezzle.sezzlemobile'] },
  { name: 'Rokt', packages: ['com.sezzle.sezzlemobile'] },
].map((provider) => ({
  ...provider,
  apps: provider.packages
    .map((packageName) => apps.find((app) => app.packageName === packageName))
    .filter((app): app is (typeof apps)[number] => Boolean(app)),
}));
---

<BaseLayout
  title="Aidan's Morphe Patches — Block Ads, Remove Tracking & Customize Android Apps"
  description="Free, open-source patches for popular Android apps. Remove ads, block trackers, unlock hidden features, and make your favorite apps faster and cleaner."
  currentPath="/"
>
  <!-- 1. Hero Section -->
  <section class="relative px-6 py-20 md:py-24 bg-gradient-to-b from-[#0a0a0a] via-[#050505] to-[#050505] overflow-hidden">
    <!-- Subtle technical grid background -->
    <div class="absolute inset-0 bg-technical-grid opacity-30 pointer-events-none"></div>

    <div class="relative z-10 max-w-2xl space-y-6">
      <div class="space-y-4">
        <h1 class="font-sans text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-[1.15] max-w-xl [text-wrap:balance]">
          Make your apps work the way they should.
        </h1>
        <p class="font-sans text-base sm:text-lg text-zinc-400 max-w-xl leading-relaxed">
          Block ads and creepy trackers, unlock hidden features, and customize
          your favorite Android apps to make them truly yours.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2 font-mono text-xs">
        <GlowButton
          variant="morphe"
          href="https://morphe.software/add-source?github=ihatenodejs/aidans-patches"
        >
          <MorpheIcon class="h-3.5 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" />
          <span>Add to Morphe</span>
        </GlowButton>
        <GlowButton
          variant="github"
          href="https://github.com/ihatenodejs/aidans-patches"
        >
          <GitHubIcon class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" />
          <span>View on GitHub</span>
        </GlowButton>
      </div>
    </div>
  </section>

  <!-- 2. Live Repository Stats Strip -->
  <StatsStrip />

  <!-- 3. Built Around The Apps I Actually Use -->
  <section class="space-y-6 px-4 py-4 sm:px-6 sm:py-6 md:px-8 md:py-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <h2 class="font-sans text-xl font-bold tracking-tight text-white">
          Supported apps
        </h2>
      </div>
    </div>

    <!-- App Preview Grid: 2 rows on desktop (with View More at 2,4), 2 rows on mobile (with View More at 2,2) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/[0.08] bg-clip-padding border border-white/[0.08] overflow-hidden">
      {apps.slice(0, 3).map((app) => (
        <AppPreviewCard app={app} />
      ))}

      <!-- Mobile View More Card (Row 2, Col 2 on <lg) -->
      <ViewMoreAppsCard
        count={apps.length - 3}
        remainingApps={apps.slice(3)}
        className="flex lg:hidden"
      />

      <!-- Desktop-only apps (completes Row 1 Col 4 and Row 2 Cols 1-3) -->
      {apps.slice(3, 7).map((app) => (
        <AppPreviewCard app={app} className="hidden lg:flex" />
      ))}

      <!-- Desktop View More Card (Row 2, Col 4 on >=lg) -->
      <ViewMoreAppsCard
        count={apps.length - 7}
        remainingApps={apps.slice(7)}
        className="hidden lg:flex"
      />
    </div>
  </section>

  <GridLine withCrosshairs={true} />

  <!-- 4. What Patches Can Do For You (Vercel-Style Bento) -->
  <section class="space-y-6 px-6 py-6 md:px-8 md:py-8">
    <h2 class="font-sans text-xl font-bold tracking-tight text-white">
      What can our patches do for you?
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Bento Cell 1: Privacy -->
      <BentoCard title="Privacy & Tracker Blocking">
        <svg
          slot="icon"
          class="w-4 h-4 text-emerald-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          />
        </svg>
        <p class="text-xs text-zinc-400 leading-relaxed mb-4">
          Keep more of your life to yourself. Cut the trackers and ads that
          follow you around.
        </p>
        <div class="grid grid-cols-[3fr_2fr] gap-2 p-3 bg-zinc-950/80 border border-white/[0.06] rounded-sm font-mono text-[11px]">
          {trackerProviders.map((provider) => (
            <div class="flex min-w-0 items-center gap-2 text-zinc-300">
              <div class="flex shrink-0 items-center pl-0.5">
                {provider.apps.map((app, index) => (
                  <a
                    href={`/apps/${app.id}`}
                    title={`${app.name} contains ${provider.name}`}
                    aria-label={`${app.name} contains ${provider.name}`}
                    class={`relative block rounded-full transition-transform hover:z-10 hover:scale-110 focus-visible:z-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-400 ${
                      index === 0 ? '' : '-ml-1.5'
                    }`}
                  >
                    <AppIcon
                      packageName={app.packageName}
                      name={app.name}
                      size={16}
                      className="h-4 w-4 rounded-full border border-zinc-950"
                      fallbackClassName="rounded-full text-[7px]"
                      fallbackColor={app.appIconColor}
                    />
                  </a>
                ))}
              </div>
              <span class="truncate">{provider.name}</span>
            </div>
          ))}
        </div>
      </BentoCard>

      <!-- Bento Cell 2: Customization -->
      <BentoCard title="Custom Themes & Styling">
        <svg
          slot="icon"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4 text-violet-400 shrink-0"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
          <path d="M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.582 9 8c0 1.06 -.474 2.078 -1.318 2.828c-.844 .75 -1.989 1.172 -3.182 1.172h-2.5a2 2 0 0 0 -1 3.75a1.3 1.3 0 0 1 -1 2.25" />
          <path d="M7.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
          <path d="M11.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
          <path d="M15.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
        </svg>
        <p class="text-xs text-zinc-400 leading-relaxed mb-4">
          Make your favorite apps feel more like yours—right down to the colors,
          theme, and emoji.
        </p>
        <div class="grid grid-cols-2 gap-3 border border-white/[0.06] bg-zinc-950/80 p-3 md:grid-cols-3">
          <button
            type="button"
            data-theme-preview
            aria-pressed="true"
            class="group/theme relative hidden aspect-square min-w-0 flex-col justify-between overflow-hidden rounded-sm border border-violet-400/30 bg-[#120d1f] p-3 text-left shadow-[inset_0_0_24px_rgba(139,92,246,0.12)] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-violet-300 md:flex"
          >
            <span
              data-theme-label
              class="relative text-xs font-semibold tracking-tight text-white"
            >
              Dark
            </span>
            <span class="relative flex items-center justify-between gap-2">
              <svg
                data-theme-icon
                class="h-5 w-5 text-violet-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                />
              </svg>
              <span
                data-theme-switch
                class="relative inline-flex h-5 w-9 items-center rounded-full bg-violet-400/25 p-0.5 ring-1 ring-inset ring-violet-300/40"
              >
                <span class="h-4 w-4 translate-x-4 rounded-full bg-violet-100 shadow-sm transition-transform"></span>
              </span>
            </span>
          </button>

          <label class="relative flex aspect-square min-w-0 cursor-pointer flex-col justify-between overflow-hidden rounded-sm border border-amber-400/25 bg-amber-950/15 p-3 transition-colors hover:border-amber-300/50 focus-within:outline focus-within:outline-2 focus-within:outline-amber-300">
            <img
              data-emoji-preview
              src="/feature-previews/grinning-ios.webp"
              alt="iOS grinning emoji"
              width="96"
              height="96"
              class="h-10 w-10 object-contain"
            />
            <span class="relative">
              <span class="sr-only">Emoji style</span>
              <select
                data-emoji-style
                class="w-full appearance-none rounded-sm border border-amber-300/25 bg-amber-950/50 px-2 py-1 pr-5 text-[10px] font-medium text-amber-50 outline-none transition-colors focus:border-amber-300"
              >
                <option value="ios">iOS</option>
                <option value="google">Google</option>
                <option value="facebook">Facebook</option>
                <option value="twemoji">Twemoji</option>
              </select>
              <svg
                class="pointer-events-none absolute right-1.5 top-1/2 h-3 w-3 -translate-y-1/2 text-amber-200"
                viewBox="0 0 12 12"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="m3 4.5 3 3 3-3"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </label>

          <div class="relative flex aspect-square min-w-0 flex-col justify-between overflow-hidden rounded-sm border border-emerald-400/25 bg-emerald-950/15 p-3">
            <div
              data-brand-icon
              class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-[10px] bg-[#05c779] shadow-[0_4px_12px_rgba(5,199,121,0.25)] transition-colors"
            >
              <img
                data-brand-image
                src="/feature-previews/sidelineswap.webp"
                alt="SidelineSwap app icon"
                width="96"
                height="96"
                class="h-full w-full transition-[filter]"
              />
            </div>
            <div class="flex gap-1.5" aria-label="Brand color">
              <button
                type="button"
                data-brand-color="violet"
                aria-label="Violet brand color"
                class="aspect-square flex-1 bg-violet-500 ring-1 ring-white/15 transition-transform hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
              ></button>
              <button
                type="button"
                data-brand-color="emerald"
                aria-label="Emerald brand color"
                aria-pressed="true"
                class="aspect-square flex-1 bg-emerald-400 ring-1 ring-white/40 transition-transform hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
              ></button>
              <button
                type="button"
                data-brand-color="blue"
                aria-label="Blue brand color"
                class="aspect-square flex-1 bg-blue-500 ring-1 ring-white/15 transition-transform hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
              ></button>
              <button
                type="button"
                data-brand-color="orange"
                aria-label="Orange brand color"
                class="aspect-square flex-1 bg-orange-400 ring-1 ring-white/15 transition-transform hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
              ></button>
            </div>
          </div>
        </div>
      </BentoCard>

      <!-- Bento Cell 3: Feature Unlocks & Enhancements -->
      <BentoCard title="Unlock & Add New Features">
        <svg
          slot="icon"
          class="w-4 h-4 text-blue-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
          />
        </svg>
        <div class="space-y-2.5">
          <div class="grid grid-cols-2 gap-2.5">
            <article class="group/map relative aspect-square overflow-hidden border border-blue-400/20 bg-blue-950/15 p-3.5 transition-colors hover:border-blue-300/40">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_100%_0%,rgba(96,165,250,0.16),transparent_52%)]"></div>
              <div class="relative flex h-full flex-col justify-between">
                <span
                  class="h-14 w-14 shrink-0 bg-[linear-gradient(135deg,#77ae61_0%,#abd874_52%,#e5d36e_100%)] opacity-95 transition-transform duration-300 group-hover/map:-translate-y-0.5"
                  style="-webkit-mask: url('/icons/openstreetmap.svg') center / contain no-repeat; mask: url('/icons/openstreetmap.svg') center / contain no-repeat;"
                  aria-label="OpenStreetMap"
                  role="img"
                ></span>
                <h4 class="font-sans text-sm font-semibold tracking-tight text-white">
                  Change your map
                </h4>
              </div>
            </article>

            <article class="group/premium relative aspect-square overflow-hidden border border-violet-400/20 bg-violet-950/15 p-3.5 transition-colors hover:border-violet-300/40">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_0%_0%,rgba(192,132,252,0.16),transparent_56%)]"></div>
              <div class="relative flex h-full flex-col justify-between">
                <div class="grid grid-cols-2 gap-1.5 self-end">
                  <a
                    href="/apps/sezzle"
                    aria-label="View Sezzle patches"
                    class="rounded-[7px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                  >
                    <AppIcon
                      packageName="com.sezzle.sezzlemobile"
                      name="Sezzle"
                      size={28}
                      className="border border-white/10 rounded-[7px] shadow-sm transition-transform duration-300 group-hover/premium:-translate-y-0.5"
                    />
                  </a>
                  <a
                    href="/apps/geocaching"
                    aria-label="View Geocaching patches"
                    class="rounded-[7px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                  >
                    <AppIcon
                      packageName="com.groundspeak.geocaching.intro"
                      name="Geocaching"
                      size={28}
                      className="border border-white/10 rounded-[7px] shadow-sm transition-transform duration-300 group-hover/premium:-translate-y-0.5 [transition-delay:50ms]"
                    />
                  </a>
                  <a
                    href="/apps/fizz"
                    aria-label="View Fizz patches"
                    class="rounded-[7px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                  >
                    <AppIcon
                      packageName="com.ashtoncofer.Buzz"
                      name="Fizz"
                      size={28}
                      className="border border-white/10 rounded-[7px] shadow-sm transition-transform duration-300 group-hover/premium:-translate-y-0.5 [transition-delay:100ms]"
                    />
                  </a>
                  <a
                    href="/apps/adobe-scan"
                    aria-label="View Adobe Scan patches"
                    class="rounded-[7px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                  >
                    <AppIcon
                      packageName="com.adobe.scan.android"
                      name="Adobe Scan"
                      size={28}
                      className="border border-white/10 rounded-[7px] shadow-sm transition-transform duration-300 group-hover/premium:-translate-y-0.5 [transition-delay:150ms]"
                    />
                  </a>
                </div>
                <h4 class="ml-auto max-w-28 text-right font-sans text-sm font-semibold leading-tight tracking-tight text-white">
                  Unlock premium features
                </h4>
              </div>
            </article>
          </div>

          <article class="grid min-h-44 grid-rows-[auto_1fr] overflow-hidden border border-emerald-400/20 bg-emerald-950/10 transition-colors hover:border-emerald-300/40">
            <header class="relative border-b border-emerald-300/10 px-3.5 py-2.5">
              <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(52,211,153,0.13),transparent_58%)]"></div>
              <h4 class="relative font-sans text-sm font-semibold tracking-tight text-white">
                Enable hidden features
              </h4>
            </header>
            <ul class="grid content-center gap-1.5 p-2.5 font-mono text-[9px] sm:grid-cols-2 xl:grid-cols-3">
              <li class="group flex min-w-0 items-center gap-2 border border-white/[0.06] bg-black/20 px-2 py-1.5 text-zinc-200 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-px hover:border-emerald-300/40 hover:bg-emerald-400/[0.07]">
                <a
                  href="/apps/sezzle"
                  aria-label="View Sezzle patches"
                  class="rounded-[5px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                >
                  <AppIcon
                    packageName="com.sezzle.sezzlemobile"
                    name="Sezzle"
                    size={18}
                    className="rounded-[5px] transition-transform duration-200 group-hover:scale-105"
                  />
                </a>
                <span class="leading-tight">Receipt Scanner</span>
              </li>
              <li class="group flex min-w-0 items-center gap-2 border border-white/[0.06] bg-black/20 px-2 py-1.5 text-zinc-200 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-px hover:border-emerald-300/40 hover:bg-emerald-400/[0.07]">
                <a
                  href="/apps/sezzle"
                  aria-label="View Sezzle patches"
                  class="rounded-[5px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                >
                  <AppIcon
                    packageName="com.sezzle.sezzlemobile"
                    name="Sezzle"
                    size={18}
                    className="rounded-[5px] transition-transform duration-200 group-hover:scale-105"
                  />
                </a>
                <span class="leading-tight">Custom App Icons</span>
              </li>
              <li class="group flex min-w-0 items-center gap-2 border border-white/[0.06] bg-black/20 px-2 py-1.5 text-zinc-200 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-px hover:border-emerald-300/40 hover:bg-emerald-400/[0.07]">
                <a
                  href="/apps/geocaching"
                  aria-label="View Geocaching patches"
                  class="rounded-[5px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                >
                  <AppIcon
                    packageName="com.groundspeak.geocaching.intro"
                    name="Geocaching"
                    size={18}
                    className="rounded-[5px] transition-transform duration-200 group-hover:scale-105"
                  />
                </a>
                <span class="leading-tight">Experimental Features</span>
              </li>
              <li class="group flex min-w-0 items-center gap-2 border border-white/[0.06] bg-black/20 px-2 py-1.5 text-zinc-200 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-px hover:border-emerald-300/40 hover:bg-emerald-400/[0.07]">
                <a
                  href="/apps/geocaching"
                  aria-label="View Geocaching patches"
                  class="rounded-[5px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                >
                  <AppIcon
                    packageName="com.groundspeak.geocaching.intro"
                    name="Geocaching"
                    size={18}
                    className="rounded-[5px] transition-transform duration-200 group-hover:scale-105"
                  />
                </a>
                <span class="leading-tight">10% Projects</span>
              </li>
              <li class="group flex min-w-0 items-center gap-2 border border-white/[0.06] bg-black/20 px-2 py-1.5 text-zinc-200 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-px hover:border-emerald-300/40 hover:bg-emerald-400/[0.07]">
                <a
                  href="/apps/fizz"
                  aria-label="View Fizz patches"
                  class="rounded-[5px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                >
                  <AppIcon
                    packageName="com.ashtoncofer.Buzz"
                    name="Fizz"
                    size={18}
                    className="rounded-[5px] transition-transform duration-200 group-hover:scale-105"
                  />
                </a>
                <span class="leading-tight">Mobile Studio</span>
              </li>
              <li class="group flex min-w-0 items-center gap-2 border border-white/[0.06] bg-black/20 px-2 py-1.5 text-zinc-200 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-px hover:border-emerald-300/40 hover:bg-emerald-400/[0.07]">
                <a
                  href="/apps/adobe-scan"
                  aria-label="View Adobe Scan patches"
                  class="rounded-[5px] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/70"
                >
                  <AppIcon
                    packageName="com.adobe.scan.android"
                    name="Adobe Scan"
                    size={18}
