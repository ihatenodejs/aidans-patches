  </section>

  <!-- Client-side live hydration from Cloudflare Worker -->
  <script>
    import {
      loadStatusPayload,
      type PublicStatusPayload,
    } from '../data/status-client';

    const rows = document.querySelectorAll('tr[data-package]');

    const themePreview = document.querySelector<HTMLButtonElement>(
      '[data-theme-preview]',
    );
    const themeLabel =
      document.querySelector<HTMLElement>('[data-theme-label]');
    const themeSwitch = document.querySelector<HTMLElement>(
      '[data-theme-switch]',
    );
    const themeIcon = document.querySelector<SVGElement>('[data-theme-icon]');

    if (themePreview && themeLabel && themeSwitch && themeIcon) {
      const themeKnob = themeSwitch.firstElementChild;
      let isDark = true;

      themePreview.addEventListener('click', () => {
        isDark = !isDark;
        themePreview.setAttribute('aria-pressed', String(isDark));
        themeLabel.textContent = isDark ? 'Dark' : 'Light';
        themePreview.classList.toggle('bg-[#120d1f]', isDark);
        themePreview.classList.toggle('border-violet-400/30', isDark);
        themePreview.classList.toggle(
          'shadow-[inset_0_0_24px_rgba(139,92,246,0.12)]',
          isDark,
        );
        themePreview.classList.toggle('bg-amber-50', !isDark);
        themePreview.classList.toggle('border-amber-300/60', !isDark);
        themePreview.classList.toggle(
          'shadow-[inset_0_0_24px_rgba(251,191,36,0.2)]',
          !isDark,
        );
        themeLabel.classList.toggle('text-white', isDark);
        themeLabel.classList.toggle('text-amber-950', !isDark);
        themeIcon.classList.toggle('text-violet-200', isDark);
        themeIcon.classList.toggle('text-amber-500', !isDark);
        themeIcon.innerHTML = isDark
          ? '<path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />'
          : '<circle cx="12" cy="12" r="4" /><path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />';

        if (themeKnob) {
          themeKnob.classList.toggle('translate-x-4', isDark);
          themeKnob.classList.toggle('translate-x-0', !isDark);
          themeKnob.classList.toggle('bg-violet-100', isDark);
          themeKnob.classList.toggle('bg-amber-400', !isDark);
        }
        themeSwitch.classList.toggle('bg-violet-400/25', isDark);
        themeSwitch.classList.toggle('ring-violet-300/40', isDark);
        themeSwitch.classList.toggle('bg-amber-300/40', !isDark);
        themeSwitch.classList.toggle('ring-amber-400/50', !isDark);
      });
    }

    const emojiStyle =
      document.querySelector<HTMLSelectElement>('[data-emoji-style]');
    const emojiPreview = document.querySelector<HTMLImageElement>(
      '[data-emoji-preview]',
    );
    const emojiSources: Record<string, string> = {
      ios: '/feature-previews/grinning-ios.webp',
      google: '/feature-previews/grinning-google.webp',
      facebook: '/feature-previews/grinning-facebook.webp',
      twemoji: '/feature-previews/grinning-twemoji.webp',
    };

    if (emojiStyle && emojiPreview) {
      emojiStyle.addEventListener('change', () => {
        const style = emojiStyle.value;
        emojiPreview.src = emojiSources[style] ?? emojiSources.ios;
        emojiPreview.alt = `${emojiStyle.options[emojiStyle.selectedIndex].text} grinning emoji`;
      });
    }

    const brandIcon = document.querySelector<HTMLElement>('[data-brand-icon]');
    const brandImage =
      document.querySelector<HTMLImageElement>('[data-brand-image]');
    const brandOptions =
      document.querySelectorAll<HTMLButtonElement>('[data-brand-color]');
    const brandColors: Record<string, { color: string; filter: string }> = {
      violet: { color: '#8b5cf6', filter: 'hue-rotate(116deg) saturate(1.25)' },
      emerald: { color: '#05c779', filter: 'none' },
      blue: { color: '#2787f5', filter: 'hue-rotate(54deg) saturate(1.25)' },
      orange: { color: '#fb923c', filter: 'hue-rotate(-105deg) saturate(1.2)' },
    };

    if (brandIcon && brandImage) {
      brandOptions.forEach((option) => {
        option.addEventListener('click', () => {
          const color = brandColors[option.dataset.brandColor ?? ''];
          if (!color) return;

          brandIcon.style.backgroundColor = color.color;
          brandImage.style.filter = color.filter;
          brandOptions.forEach((button) => {
            button.setAttribute('aria-pressed', String(button === option));
            button.classList.toggle('ring-white/40', button === option);
            button.classList.toggle('ring-white/15', button !== option);
          });
        });
      });
    }

    function applyStatusData(data: PublicStatusPayload) {
      if (!data || !data.apps) return;
      rows.forEach((row) => {
        const pkg = row.getAttribute('data-package');
        if (!pkg) return;
        const appData = data.apps[pkg];
        if (!appData) return;

        const playCell = row.querySelector('.play-version');
        const badgeCell = row.querySelector('.status-badge-cell');

        const effectivePlayVersion = appData.playVersion || null;

        if (playCell) {
          playCell.textContent = effectivePlayVersion
            ? 'v' + effectivePlayVersion
            : '—';
        }

        const effectiveStatus = appData.status;

        if (badgeCell) {
          if (effectiveStatus === 'up-to-date') {
            badgeCell.innerHTML = `
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-emerald-950/60 text-emerald-400 border border-emerald-800/40 whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                <span>Up to date</span>
              </span>
            `;
          } else if (effectiveStatus === 'newer-available') {
            badgeCell.innerHTML = `
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-amber-950/60 text-amber-400 border border-amber-800/40 whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
                <span>Newer version available</span>
              </span>
            `;
          } else if (effectiveStatus === 'check-failed') {
            badgeCell.innerHTML = `
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-rose-950/60 text-rose-400 border border-rose-800/40 whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-400 shrink-0"></span>
                <span>Check failed</span>
              </span>
            `;
          } else if (effectiveStatus === 'not-on-play-store') {
            badgeCell.innerHTML = `
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-zinc-900 text-zinc-500 border border-white/10 whitespace-nowrap">
                <span>Not on Play Store</span>
              </span>
            `;
          } else {
            badgeCell.innerHTML = `
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-zinc-900 text-zinc-400 border border-white/10 whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-500 shrink-0"></span>
                <span>Unknown</span>
              </span>
            `;
          }
        }
      });
    }

    loadStatusPayload().then((payload) => {
      if (payload) {
        applyStatusData(payload);
      }
    });
  </script>
</BaseLayout>
