---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getApps,
  getInitialVersionStatuses,
  getRepositoryStats,
  getLatestPlayRelease,
} from '../data/repo';
const apps = getApps();
const initialStatuses = getInitialVersionStatuses();
const stats = getRepositoryStats();
const latestReleaseApp = getLatestPlayRelease();
const workerUrl =
  import.meta.env.PUBLIC_WORKER_URL || 'https://worker.patch.p0ntus.com';

function getNextCheckCountdown(): string {
  const now = new Date();
  const nextHour = (Math.floor(now.getUTCHours() / 6) + 1) * 6;
  const nextCheck = new Date(
    Date.UTC(
      now.getUTCFullYear(),
      now.getUTCMonth(),
      now.getUTCDate(),
      0,
      0,
      0,
      0,
    ),
  );
  nextCheck.setUTCHours(nextHour);
  if (nextCheck.getTime() <= now.getTime()) {
    nextCheck.setUTCHours(nextCheck.getUTCHours() + 6);
  }
  const diff = Math.max(0, nextCheck.getTime() - now.getTime());
  const hours = Math.floor(diff / (1000 * 60 * 60));
  const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
  return `in ${hours}h ${mins}m`;
}

function formatRelativeTime(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    const now = new Date();
    const diffSec = Math.floor((now.getTime() - d.getTime()) / 1000);
    if (diffSec < 60) return 'just now';
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60)
      return `${diffMin} ${diffMin === 1 ? 'minute' : 'minutes'} ago`;
    const diffHours = Math.floor(diffMin / 60);
    if (diffHours < 24)
      return `${diffHours} ${diffHours === 1 ? 'hour' : 'hours'} ago`;
    const diffDays = Math.floor(diffHours / 24);
    if (diffDays < 30)
      return `${diffDays} ${diffDays === 1 ? 'day' : 'days'} ago`;
    const diffMonths = Math.floor(diffDays / 30);
    if (diffMonths < 12)
      return `${diffMonths} ${diffMonths === 1 ? 'month' : 'months'} ago`;
    return dateStr.split('T')[0];
  } catch {
    return dateStr;
  }
}
---

<BaseLayout
  title="App Compatibility & Status — Aidan's Morphe Patches"
  description="Check real-time compatibility for all supported Android apps. See tested versions compared with the latest Google Play releases."
  currentPath="/status"
>
  <div
    class="px-4 sm:px-6 py-10 space-y-8"
    id="status-container"
    data-worker-url={workerUrl}
  >
    <!-- Header Section -->
    <div class="space-y-3">
      <h1 class="font-sans text-3xl font-extrabold tracking-tight text-white">
        App Compatibility &amp; Status
      </h1>
      <p class="font-sans text-sm text-zinc-400 max-w-2xl leading-relaxed">
        See tested and supported versions across all {apps.length} apps. We
        verify each release to ensure patches work smoothly, and check Google
        Play regularly so you know when new updates arrive.
      </p>
    </div>

    <!-- Status Overview Cards (Clean values without secondary descriptions) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-white/[0.08] bg-clip-padding border border-white/[0.08]">
      <div class="p-5 bg-[#080808] space-y-1">
        <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-wider">
          Supported Apps
        </div>
        <div class="text-2xl font-bold font-sans text-white">
          {apps.length} Applications
        </div>
      </div>
      <div class="p-5 bg-[#080808] space-y-1">
        <div
          class="font-mono text-[10px] text-zinc-500 uppercase tracking-wider"
          title="Scheduled check for Google Play updates and metadata"
        >
          Play Store Check
        </div>
        <div
          class="text-2xl font-bold font-mono text-white"
          id="countdown-timer"
        >
          {getNextCheckCountdown()}
        </div>
      </div>
      <div class="p-5 bg-[#080808] space-y-1">
        <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-wider">
          Latest App Update
        </div>
        <div class="flex items-center gap-2.5 min-h-[32px]">
          {latestReleaseApp.iconUrl ? (
            <Image
              id="latest-release-icon"
              src={latestReleaseApp.iconUrl}
              alt={latestReleaseApp.appName}
              width={24}
              height={24}
              class="w-6 h-6 rounded-sm object-cover border border-white/10 shrink-0"
              loading="eager"
            />
          ) : (
            <span
              id="latest-release-fallback-icon"
              class="w-6 h-6 rounded-sm bg-zinc-900 border border-white/10 flex items-center justify-center font-mono text-[10px] text-zinc-400 shrink-0"
            >
              {latestReleaseApp.appName.charAt(0)}
            </span>
          )}
          <div class="flex items-baseline gap-2 min-w-0">
            <span
              id="latest-release-name"
              class="text-2xl font-bold font-sans text-white truncate"
            >
              {latestReleaseApp.appName}
            </span>
            <span
              id="latest-release-time"
              class="font-mono text-xs text-zinc-400 font-normal shrink-0"
              title={
                latestReleaseApp.updatedOn
                  ? `Updated on Google Play: ${latestReleaseApp.updatedOn}`
                  : ''
              }
            >
              {latestReleaseApp.updatedAt
                ? formatRelativeTime(latestReleaseApp.updatedAt)
                : ''}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Status Table with Pinned Columns on Mobile -->
    <div class="border border-white/[0.08] bg-[#080808] rounded-sm overflow-hidden">
      <!-- Search Bar Header -->
      <div class="p-3 bg-zinc-950 border-b border-white/[0.08] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="relative w-full max-w-sm">
          <input
            type="search"
            id="status-search-input"
            placeholder="Search applications..."
            class="w-full bg-zinc-900 border border-white/10 px-3 py-1.5 pl-8 text-xs font-mono text-white placeholder-zinc-500 rounded-sm focus:outline-none focus:border-white/30"
          />
          <svg
            class="w-3.5 h-3.5 text-zinc-500 absolute left-2.5 top-2.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
        </div>

        <span
          class="font-mono text-[11px] text-zinc-500 shrink-0"
          id="last-updated-label"
        >
          Bundle released: {stats.releaseDate}
        </span>
      </div>

      <!-- Horizontal Scrollable Container with Sticky Application & Freshness Columns -->
      <div class="overflow-x-auto relative">
        <table class="w-full text-left font-mono text-xs border-collapse">
          <thead>
            <tr class="border-b border-white/[0.08] text-[11px] text-zinc-500 uppercase tracking-wider">
              <!-- Sticky Left: Application Column -->
              <th class="py-3 px-4 sticky left-0 z-20 bg-zinc-950 shadow-[1px_0_0_rgba(255,255,255,0.08)]">
                Application
              </th>
              <th class="py-3 px-4 bg-zinc-950/60 whitespace-nowrap hidden md:table-cell">
                Target
              </th>
              <th class="py-3 px-4 bg-zinc-950/60 whitespace-nowrap hidden sm:table-cell">
                Google Play
              </th>
              <th class="py-3 px-4 bg-zinc-950/60 whitespace-nowrap">
                Tests Passed
              </th>
              <th class="py-3 px-4 text-right sticky right-0 z-20 bg-zinc-950 shadow-[-1px_0_0_rgba(255,255,255,0.08)] whitespace-nowrap">
                Update Status
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.06]" id="status-tbody">
            {initialStatuses.map((item) => (
              <tr
                class="hover:bg-white/[0.02] transition-colors group/row"
                data-package={item.packageName}
                data-app-name={item.appName.toLowerCase()}
              >
                <!-- Sticky Left: Application Cell -->
                <td class="py-3.5 px-4 font-sans font-semibold text-white sticky left-0 z-10 bg-[#080808] group-hover/row:bg-[#0c0c0c] shadow-[1px_0_0_rgba(255,255,255,0.08)] whitespace-nowrap">
                  <div class="flex items-center gap-2.5">
                    {item.iconUrl ? (
                      <Image
                        src={item.iconUrl}
                        alt={item.appName}
                        width={20}
                        height={20}
                        class="w-5 h-5 rounded-sm object-cover border border-white/10 shrink-0"
                        loading="eager"
                      />
                    ) : (
                      <span class="w-5 h-5 rounded-sm bg-zinc-900 border border-white/10 flex items-center justify-center font-mono text-[10px] text-zinc-400 shrink-0">
                        {item.appName.charAt(0)}
                      </span>
                    )}
                    <a
                      href={`/patches#${item.appId}`}
                      class="hover:text-zinc-200 transition-colors"
                    >
                      {item.appName}
                    </a>
                  </div>
                </td>

                <td class="py-3.5 px-4 text-zinc-200 whitespace-nowrap hidden md:table-cell">
                  v{item.latestSupportedVersion}
                </td>
                <td class="py-3.5 px-4 text-zinc-400 play-version whitespace-nowrap hidden sm:table-cell">
                  {item.playVersion ? `v${item.playVersion}` : '—'}
                </td>

                <!-- Tests Passed Column -->
                <td class="py-3.5 px-4 target-compat-cell whitespace-nowrap">
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-zinc-900 text-zinc-400 border border-white/10">
                    <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
                    <span>Checking...</span>
                  </span>
                </td>

                <!-- Update Status Column (Pinned on mobile) -->
                <td class="py-3.5 px-4 text-right play-freshness-cell sticky right-0 z-10 bg-[#080808] group-hover/row:bg-[#0c0c0c] shadow-[-1px_0_0_rgba(255,255,255,0.08)] whitespace-nowrap">
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-zinc-900 text-zinc-400 border border-white/10">
                    <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
                    <span>Checking...</span>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Empty Filter State -->
      <div
        id="status-no-results"
        class="hidden p-8 text-center font-mono text-xs text-zinc-500 border-t border-white/[0.06]"
      >
        No matching applications found.
      </div>
    </div>

    <!-- Refactored Explanatory Box (Icons, Clarity, Status Definitions & Update Context) -->
    <div class="p-6 border border-white/[0.08] bg-[#070707] rounded-sm space-y-6 text-xs text-zinc-300">
      <div class="flex items-center gap-2 text-white font-mono text-xs uppercase tracking-wider font-semibold">
        <svg
          class="w-4 h-4 text-blue-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="9" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
          <polyline points="11 12 12 12 12 16 13 16" />
        </svg>
        <span>How Version Compatibility Works</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1">
        <div class="space-y-2 p-4 bg-zinc-950/60 border border-white/[0.06] rounded-sm">
          <div class="font-sans font-semibold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Update Status</span>
          </div>
          <p class="text-zinc-400 leading-relaxed text-[11px]">
            Compares the latest release on Google Play against the version
            tested here. When an app updates in the store, existing patches
            usually continue to work without issues.
          </p>
        </div>

        <div class="space-y-2 p-4 bg-zinc-950/60 border border-white/[0.06] rounded-sm">
          <div class="font-sans font-semibold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            <span>Tests Passed</span>
          </div>
          <p class="text-zinc-400 leading-relaxed text-[11px]">
            Automated tests run against the target APK whenever patch code
            changes in the repository, verifying patch application, Cloudflare
            artifact persistence, and DEX structural integrity.
          </p>
        </div>
      </div>

      <div class="p-3 bg-zinc-900/40 border border-white/[0.06] rounded-sm text-[11px] text-zinc-400 font-sans leading-relaxed">
        <strong class="text-zinc-200">Note on Compatibility:</strong>{' '}
        &ldquo;Compatible&rdquo; indicates automated verification passed (Morphe
        bytecode/resource transformations, package integrity, and DEX structural
        checks). Device runtime behavior and UI flows remain verified via
        separate manual smoke tests.
      </div>
    </div>
  </div>

  <!-- Client-side hydration, countdown timer, and search filter script -->
  <script>
    import { renderCompatBadgeHtml } from '../data/status';

    const container = document.getElementById('status-container');
    const workerUrl =
      container?.getAttribute('data-worker-url') ||
      'https://worker.patch.p0ntus.com';

    // 1. Live Countdown Timer to next UTC six-hour boundary (for Google Play freshness)
    function updateCountdown() {
      const now = new Date();
      const nextHour = (Math.floor(now.getUTCHours() / 6) + 1) * 6;
      const nextCheck = new Date(
        Date.UTC(
          now.getUTCFullYear(),
          now.getUTCMonth(),
          now.getUTCDate(),
          0,
          0,
          0,
          0,
        ),
      );
      nextCheck.setUTCHours(nextHour);
      if (nextCheck.getTime() <= now.getTime()) {
        nextCheck.setUTCHours(nextCheck.getUTCHours() + 6);
      }
      const diff = Math.max(0, nextCheck.getTime() - now.getTime());
      const hours = Math.floor(diff / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const timerEl = document.getElementById('countdown-timer');
      if (timerEl) {
        timerEl.textContent = 'in ' + hours + 'h ' + mins + 'm';
      }
    }
    updateCountdown();
    setInterval(updateCountdown, 30000);

    // 2. Relative time helper
    function formatRelative(dateStr: string) {
      if (!dateStr) return 'Cached';
      try {
        const d = new Date(dateStr);
        const now = new Date();
        const diffSec = Math.floor((now.getTime() - d.getTime()) / 1000);
        if (diffSec < 60) return 'just now';
        const diffMin = Math.floor(diffSec / 60);
        if (diffMin < 60)
          return diffMin + (diffMin === 1 ? ' minute ago' : ' minutes ago');
        const diffHours = Math.floor(diffMin / 60);
        if (diffHours < 24)
          return diffHours + (diffHours === 1 ? ' hour ago' : ' hours ago');
        const diffDays = Math.floor(diffHours / 24);
        if (diffDays < 30)
          return diffDays + (diffDays === 1 ? ' day ago' : ' days ago');
        const diffMonths = Math.floor(diffDays / 30);
        if (diffMonths < 12)
          return diffMonths + (diffMonths === 1 ? ' month ago' : ' months ago');
        return dateStr.split('T')[0];
      } catch {
        return dateStr;
      }
    }

    // 3. Search Filter
    const searchInput = document.getElementById(
      'status-search-input',
    ) as HTMLInputElement | null;
    const rows = document.querySelectorAll<HTMLTableRowElement>(
      '#status-tbody tr[data-package]',
    );
    const noResults = document.getElementById('status-no-results');

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();
        let visible = 0;

        rows.forEach((row) => {
          const pkg = (row.getAttribute('data-package') || '').toLowerCase();
          const name = (row.getAttribute('data-app-name') || '').toLowerCase();
          const matches = !query || pkg.includes(query) || name.includes(query);
          row.style.display = matches ? '' : 'none';
          if (matches) visible++;
        });

        if (noResults) {
          noResults.classList.toggle('hidden', visible > 0);
        }
      });
    }
    // 5. Hydrate from live Cloudflare Worker API with sessionStorage caching
    const STATUS_CACHE_KEY = 'aidans_patches_status_cache';
    const STATUS_CACHE_TTL_MS = 5 * 60 * 1000; // 5 minutes

    function applyStatusData(data: Record<string, any>) {
      if (!data || !data.apps) return;

      const lastUpdatedEl = document.getElementById('last-updated-label');
      if (lastUpdatedEl && data.updatedAt) {
        lastUpdatedEl.textContent =
          'Version check updated: ' + formatRelative(data.updatedAt);
      }

      // Update Latest Release card if live data is available
      const latestIconEl = document.getElementById(
        'latest-release-icon',
      ) as HTMLImageElement | null;
      const latestFallbackIconEl = document.getElementById(
        'latest-release-fallback-icon',
      );
      const latestNameEl = document.getElementById('latest-release-name');
      const latestTimeEl = document.getElementById('latest-release-time');

      let latestApp = data.latestRelease;
      if (!latestApp && data.apps) {
        let maxTime = 0;
        for (const [pkg, rawAppData] of Object.entries(data.apps)) {
          const appData = rawAppData as Record<string, any>;
          if (appData.updatedAt) {
            const t = new Date(appData.updatedAt).getTime();
            if (t > maxTime) {
              maxTime = t;
              const row = document.querySelector(
                `#status-tbody tr[data-package="${pkg}"]`,
              );
              const appName =
                appData.appName ||
                (row ? row.querySelector('td a')?.textContent?.trim() : pkg);
              latestApp = {
                packageName: pkg,
                appName: appName || pkg,
                iconUrl: appData.iconUrl || `/icons/${pkg}.png`,
                updatedAt: appData.updatedAt,
                updatedOn: appData.updatedOn,
              };
            }
          }
        }
      }

      if (latestApp) {
        if (latestIconEl) {
          const iconSrc =
            latestApp.iconUrl || `/icons/${latestApp.packageName}.png`;
          latestIconEl.src = iconSrc;
          latestIconEl.alt = latestApp.appName || 'Latest release icon';
          latestIconEl.classList.remove('hidden');
          if (latestFallbackIconEl)
            latestFallbackIconEl.classList.add('hidden');
        }
        if (latestNameEl && latestApp.appName) {
          latestNameEl.textContent = latestApp.appName;
        }
        if (latestTimeEl) {
          const timeText = latestApp.updatedAt
            ? formatRelative(latestApp.updatedAt)
            : latestApp.updatedOn || '';
          latestTimeEl.textContent = timeText;
          if (latestApp.updatedOn) {
            latestTimeEl.title =
              'Updated on Google Play: ' + latestApp.updatedOn;
          }
        }
      }

      rows.forEach((row) => {
        const pkg = row.getAttribute('data-package');
        if (!pkg) return;
        const appData = (data.apps as Record<string, any>)[pkg];
        if (!appData) return;
        const playCell = row.querySelector('.play-version');
        const playFreshnessCell = row.querySelector('.play-freshness-cell');
        const targetCompatCell = row.querySelector('.target-compat-cell');

        const effectivePlayVersion = appData.playVersion || null;

        if (playCell) {
          playCell.textContent = effectivePlayVersion
            ? 'v' + effectivePlayVersion
            : '—';
        }

        if (playFreshnessCell) {
          const effectiveStatus = appData.status;

          if (effectiveStatus === 'up-to-date') {
            playFreshnessCell.innerHTML =
              '<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-emerald-950/60 text-emerald-400 border border-emerald-800/40"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span>Up to date</span></span>';
          } else if (effectiveStatus === 'newer-available') {
            playFreshnessCell.innerHTML =
              '<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-amber-950/60 text-amber-400 border border-amber-800/40"><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><span>Newer available</span></span>';
          } else if (effectiveStatus === 'not-on-play-store') {
            playFreshnessCell.innerHTML =
              '<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-zinc-900 text-zinc-500 border border-white/10"><span>Not on Play Store</span></span>';
          } else if (effectiveStatus === 'check-failed') {
            playFreshnessCell.innerHTML =
              '<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-rose-950/60 text-rose-400 border border-rose-800/40"><span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span><span>Check failed</span></span>';
          } else {
            playFreshnessCell.innerHTML =
              '<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] bg-zinc-900 text-zinc-400 border border-white/10"><span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span><span>Unknown</span></span>';
          }
        }

        var isTargetQueued = Boolean(
          appData.outstandingRequest &&
          appData.outstandingRequest.expectedRoles &&
          appData.outstandingRequest.expectedRoles.includes('target'),
        );

        if (targetCompatCell) {
          targetCompatCell.innerHTML = renderCompatBadgeHtml(
            appData.targetCompatibility,
            'Not tested',
            isTargetQueued,
          );
        }
      });
    }

    (async function hydrate() {
      try {
        const cached = sessionStorage.getItem(STATUS_CACHE_KEY);
        if (cached) {
          try {
            const parsed = JSON.parse(cached);
            if (
              parsed &&
              parsed.data &&
              Date.now() - parsed.timestamp < STATUS_CACHE_TTL_MS
            ) {
              applyStatusData(parsed.data);
              return;
            }
          } catch {
            // Ignore invalid cache JSON
          }
        }

        const endpoint =
          typeof workerUrl !== 'undefined' && workerUrl
            ? new URL('/api/status', workerUrl).toString()
            : 'https://worker.patch.p0ntus.com/api/status';
        const response = await fetch(endpoint);
        if (!response.ok) return;

        const data = await response.json();
        if (!data || !data.apps) return;

        try {
          sessionStorage.setItem(
            STATUS_CACHE_KEY,
            JSON.stringify({ data, timestamp: Date.now() }),
          );
        } catch {
          // Ignore storage quota / private browsing errors
        }

        applyStatusData(data);
      } catch {
        // Keep static fallback
      }
    })();
  </script>
</BaseLayout>
