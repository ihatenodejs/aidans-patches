---
interface Props {
  appName: string;
}

const { appName } = Astro.props;
---

<dialog
  id="about-app-dialog"
  aria-labelledby="about-dialog-title"
  class="fixed inset-0 m-auto w-full max-w-2xl bg-transparent p-4 backdrop:bg-black/80 backdrop:backdrop-blur-sm z-50 text-white"
>
  <div class="relative flex max-h-[85vh] flex-col rounded-lg border border-white/10 bg-[#0c0c0c] p-6 shadow-2xl custom-scrollbar overflow-y-auto">
    <div class="flex items-center justify-between border-b border-white/[0.08] pb-4">
      <h2
        id="about-dialog-title"
        class="font-sans text-lg font-bold text-white tracking-tight"
      >
        About {appName}
      </h2>
      <button
        type="button"
        data-close-dialog
        aria-label="Close dialog"
        class="flex h-8 w-8 items-center justify-center rounded-sm border border-white/10 text-zinc-400 hover:border-white/25 hover:text-white transition-colors"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <!-- Full Description -->
    <div class="mt-4">
      <h3 class="font-sans text-xs font-semibold uppercase tracking-wider text-zinc-500 mb-2">
        Description
      </h3>
      <div
        data-dialog-full-description
        class="text-xs leading-relaxed text-zinc-300 font-sans whitespace-pre-line max-h-60 overflow-y-auto pr-2 custom-scrollbar"
      ></div>
    </div>

    <!-- App Facts Grid -->
    <div class="mt-6 border-t border-white/[0.08] pt-4">
      <h3 class="font-sans text-xs font-semibold uppercase tracking-wider text-zinc-500 mb-3">
        App info
      </h3>
      <dl
        data-dialog-facts-grid
        class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono"
      >
        <div
          data-fact="developer"
          class="hidden flex-col border border-white/[0.06] bg-black/30 p-2.5 rounded-sm"
        >
          <dt class="text-[10px] uppercase text-zinc-500">Offered by</dt>
          <dd
            data-fact-val
            class="mt-1 font-sans text-xs text-zinc-200 truncate"
          ></dd>
        </div>
        <div
          data-fact="updated"
          class="hidden flex-col border border-white/[0.06] bg-black/30 p-2.5 rounded-sm"
        >
          <dt class="text-[10px] uppercase text-zinc-500">Updated on</dt>
          <dd
            data-fact-val
            class="mt-1 font-sans text-xs text-zinc-200 truncate"
          ></dd>
        </div>
        <div
          data-fact="downloads"
          class="hidden flex-col border border-white/[0.06] bg-black/30 p-2.5 rounded-sm"
        >
          <dt class="text-[10px] uppercase text-zinc-500">Downloads</dt>
          <dd
            data-fact-val
            class="mt-1 font-sans text-xs text-zinc-200 truncate"
          ></dd>
        </div>
        <div
          data-fact="content-rating"
          class="hidden flex-col border border-white/[0.06] bg-black/30 p-2.5 rounded-sm"
        >
          <dt class="text-[10px] uppercase text-zinc-500">Content rating</dt>
          <dd
            data-fact-val
            class="mt-1 font-sans text-xs text-zinc-200 truncate"
          ></dd>
        </div>
        <div
          data-fact="released"
          class="hidden flex-col border border-white/[0.06] bg-black/30 p-2.5 rounded-sm"
        >
          <dt class="text-[10px] uppercase text-zinc-500">Released on</dt>
          <dd
            data-fact-val
            class="mt-1 font-sans text-xs text-zinc-200 truncate"
          ></dd>
        </div>
        <div
          data-fact="min-android"
          class="hidden flex-col border border-white/[0.06] bg-black/30 p-2.5 rounded-sm"
        >
          <dt class="text-[10px] uppercase text-zinc-500">Requires Android</dt>
          <dd
            data-fact-val
            class="mt-1 font-sans text-xs text-zinc-200 truncate"
          ></dd>
        </div>
        <div
          data-fact="iap"
          class="hidden flex-col border border-white/[0.06] bg-black/30 p-2.5 rounded-sm"
        >
          <dt class="text-[10px] uppercase text-zinc-500">In-app purchases</dt>
          <dd
            data-fact-val
            class="mt-1 font-sans text-xs text-zinc-200 truncate"
          ></dd>
        </div>
        <div
          data-fact="permissions"
          class="hidden col-span-1 sm:col-span-2 flex-col border border-white/[0.06] bg-black/30 p-2.5 rounded-sm"
        >
          <dt class="text-[10px] uppercase text-zinc-500">Permissions</dt>
          <dd data-fact-val class="mt-1 font-sans text-xs text-zinc-300"></dd>
        </div>
      </dl>
    </div>
  </div>
</dialog>
