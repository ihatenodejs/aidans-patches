---
import Crosshair from './Crosshair.astro';

interface Props {
  className?: string;
  withCrosshairs?: boolean;
}

const { className = '', withCrosshairs = false } = Astro.props;
---

<div class={`relative w-full h-px bg-white/[0.08] ${className}`}>
  {withCrosshairs && (
    <>
      <Crosshair position="left" />
      <Crosshair position="right" />
    </>
  )}
</div>
