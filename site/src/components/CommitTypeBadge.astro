---
interface Props {
  type: string;
}

const { type } = Astro.props;

interface TypeStyle {
  badgeClass: string;
  iconBorderClass: string;
  paths: string;
  label: string;
}

const PATHS = {
  sparkles: `<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2m0 -12a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2m-7 12a6 6 0 0 1 6 -6a6 6 0 0 1 -6 -6a6 6 0 0 1 -6 6a6 6 0 0 1 6 6" />`,
  bug: `<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 9v-1a3 3 0 0 1 6 0v1" /><path d="M8 9h8a6 6 0 0 1 1 3v3a5 5 0 0 1 -10 0v-3a6 6 0 0 1 1 -3" /><path d="M3 13l4 0" /><path d="M17 13l4 0" /><path d="M12 20l0 -6" /><path d="M4 19l3.35 -2" /><path d="M20 19l-3.35 -2" /><path d="M4 7l3.75 2.4" /><path d="M20 7l-3.75 2.4" />`,
  rocket: `<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 13a8 8 0 0 1 7 7a6 6 0 0 0 3 -5a9 9 0 0 0 6 -8a3 3 0 0 0 -3 -3a9 9 0 0 0 -8 6a6 6 0 0 0 -5 3" /><path d="M7 14a6 6 0 0 0 -3 6a6 6 0 0 0 6 -3" /><path d="M14 9a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />`,
  bolt: `<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11" />`,
  recycle: `<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 17l-2 2l2 2" /><path d="M10 19h9a2 2 0 0 0 1.75 -2.75l-.55 -1" /><path d="M8.536 11l-.732 -2.732l-2.732 .732" /><path d="M7.804 8.268l-4.5 7.794a2 2 0 0 0 1.506 2.89l1.141 .024" /><path d="M15.464 11l2.732 .732l.732 -2.732" /><path d="M18.196 11.732l-4.5 -7.794a2 2 0 0 0 -3.256 -.14l-.591 .976" />`,
  tool: `<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" />`,
  book: `<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" /><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" /><path d="M3 6l0 13" /><path d="M12 6l0 13" /><path d="M21 6l0 13" />`,
};

function getTypeStyle(rawType: string): TypeStyle {
  const norm = rawType.toLowerCase().trim();
  switch (norm) {
    case 'feat':
      return {
        badgeClass: 'bg-emerald-950/60 text-emerald-300 border-emerald-800/40',
        iconBorderClass: 'border-r border-emerald-800/40 bg-emerald-900/20',
        paths: PATHS.sparkles,
        label: 'FEAT',
      };
    case 'fix':
      return {
        badgeClass: 'bg-rose-950/60 text-rose-300 border-rose-800/40',
        iconBorderClass: 'border-r border-rose-800/40 bg-rose-900/20',
        paths: PATHS.bug,
        label: 'FIX',
      };
    case 'bump':
      return {
        badgeClass: 'bg-cyan-950/60 text-cyan-300 border-cyan-800/40',
        iconBorderClass: 'border-r border-cyan-800/40 bg-cyan-900/20',
        paths: PATHS.rocket,
        label: 'BUMP',
      };
    case 'perf':
      return {
        badgeClass: 'bg-amber-950/60 text-amber-300 border-amber-800/40',
        iconBorderClass: 'border-r border-amber-800/40 bg-amber-900/20',
        paths: PATHS.bolt,
        label: 'PERF',
      };
    case 'refactor':
      return {
        badgeClass: 'bg-purple-950/60 text-purple-300 border-purple-800/40',
        iconBorderClass: 'border-r border-purple-800/40 bg-purple-900/20',
        paths: PATHS.recycle,
        label: 'REFACTOR',
      };
    case 'chore':
      return {
        badgeClass: 'bg-zinc-800/70 text-zinc-300 border-zinc-700/60',
        iconBorderClass: 'border-r border-zinc-700/60 bg-zinc-800/40',
        paths: PATHS.tool,
        label: 'CHORE',
      };
    case 'docs':
      return {
        badgeClass: 'bg-sky-950/60 text-sky-300 border-sky-800/40',
        iconBorderClass: 'border-r border-sky-800/40 bg-sky-900/20',
        paths: PATHS.book,
        label: 'DOCS',
      };
    default:
      return {
        badgeClass: 'bg-zinc-900 text-zinc-400 border-white/10',
        iconBorderClass: 'border-r border-white/10 bg-white/[0.02]',
        paths: PATHS.tool,
        label: rawType.toUpperCase(),
      };
  }
}

const style = getTypeStyle(type);
---

<span
  class={`inline-flex items-center h-5 rounded-[4px] border font-mono text-[10px] uppercase tracking-tight overflow-hidden shrink-0 ${style.badgeClass}`}
>
  <span
    class={`w-5 h-5 flex items-center justify-center shrink-0 ${style.iconBorderClass}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-3 h-3"
      aria-hidden="true"
      set:html={style.paths}
    />
  </span>
  <span class="px-1.5 font-semibold leading-none">{style.label}</span>
</span>
