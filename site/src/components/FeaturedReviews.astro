---
interface Props {
  appName: string;
}

const { appName } = Astro.props;
---

<section
  id="reviews-section"
  data-reviews-section
  aria-label={`${appName} featured reviews`}
  class="hidden border-b border-white/[0.08] bg-[#070707] px-5 py-5 sm:px-8 sm:py-8"
>
  <div class="mb-5 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <h2 class="font-sans text-sm font-semibold tracking-tight text-white sm:text-base">
        Featured reviews
      </h2>
      <span class="font-mono text-[10px] text-zinc-500">Google Play users</span>
    </div>
  </div>

  <div data-reviews-container class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <!-- Template cloned during client hydration -->
    <template data-review-template>
      <div class="flex flex-col justify-between rounded-md border border-white/[0.08] bg-[#0a0a0a] p-4 shadow-sm">
        <div>
          <div class="flex items-center gap-2.5">
            <div
              data-review-avatar-container
              class="h-7 w-7 rounded-full bg-zinc-800 border border-white/10 overflow-hidden shrink-0 flex items-center justify-center font-mono text-xs text-zinc-400"
            >
              <img
                data-review-avatar
                class="hidden h-full w-full object-cover"
                alt=""
              />
              <span data-review-initial></span>
            </div>
            <div class="min-w-0 flex-1">
              <div
                data-review-author
                class="truncate font-sans text-xs font-semibold text-zinc-200"
              ></div>
              <div class="flex items-center gap-1.5 text-[10px] font-mono text-zinc-500">
                <span
                  data-review-stars
                  class="text-amber-400 tracking-tighter"
                ></span>
                <span>·</span>
                <span data-review-date></span>
              </div>
            </div>
          </div>

          <p
            data-review-text
            class="mt-3 text-xs leading-relaxed text-zinc-300 font-sans line-clamp-4"
          ></p>
        </div>

        <div
          data-review-helpful-row
          class="mt-3 border-t border-white/[0.04] pt-2 text-[10px] font-mono text-zinc-500"
        >
          <span data-review-helpful></span>
        </div>
      </div>
    </template>
  </div>
</section>
