---
import type { Patch } from '../data/types';
import Switch from './Switch.astro';

interface Props {
  patch: Patch;
}

const { patch } = Astro.props;
---

<article id={patch.id} class="scroll-mt-20 p-5 sm:p-6">
  <div class="flex flex-col gap-4">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        {patch.category && (
          <div class="mb-2 font-mono text-[9px] uppercase tracking-wider text-zinc-500">
            {patch.category}
          </div>
        )}
        <h3 class="font-sans text-base font-semibold tracking-tight text-white">
          <a
            href={`#${patch.id}`}
            class="group/title inline-flex items-center gap-2 hover:text-zinc-200"
          >
            <span>{patch.name}</span>
            <span
              class="font-mono text-xs text-zinc-700 opacity-0 transition-opacity group-hover/title:opacity-100"
              aria-hidden="true"
            >
              #
            </span>
          </a>
        </h3>
      </div>

      <div class="shrink-0 pt-0.5">
        <Switch
          checked={patch.default}
          ariaLabel={`${patch.name} default status`}
        />
      </div>
    </div>

    <p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
      {patch.description}
    </p>

    {patch.dependencies.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 text-[11px] text-zinc-500">
        <span class="font-mono uppercase tracking-wider">Works with</span>
        {patch.dependencies.map((dependency) => (
          <span class="rounded-full border border-white/[0.08] bg-white/[0.03] px-2 py-0.5 text-zinc-300">
            {dependency}
          </span>
        ))}
      </div>
    )}

    {patch.options.length > 0 && (
      <details class="group/options pt-1">
        <summary class="flex w-fit cursor-pointer select-none items-center gap-2 font-mono text-[11px] text-zinc-500 transition-colors hover:text-white">
          <svg
            class="h-3 w-3 transition-transform group-open/options:rotate-90"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m9 5 7 7-7 7"
            ></path>
          </svg>
          <span>
            Show {patch.options.length}{' '}
            {patch.options.length === 1 ? 'option' : 'options'}
          </span>
        </summary>

        <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {patch.options.map((option) => (
            <div class="border border-white/[0.07] bg-black/20 p-3.5 flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <span class="text-xs font-medium text-zinc-200">
                    {option.title}
                  </span>
                  {option.type === 'boolean' ? (
                    <Switch
                      checked={Boolean(option.default)}
                      ariaLabel={`${option.title} default`}
                      className="scale-90 origin-top-right"
                    />
                  ) : (
                    <span class="font-mono text-[9px] uppercase text-zinc-600">
                      {option.type}
                    </span>
                  )}
                </div>
                <p class="mt-1.5 text-[11px] leading-relaxed text-zinc-500">
                  {option.description}
                </p>
              </div>
              {option.type !== 'boolean' && (
                <div class="mt-3 font-mono text-[9px] text-zinc-600 border-t border-white/[0.04] pt-2">
                  Default:{' '}
                  <span class="text-zinc-400">{String(option.default)}</span>
                  {option.required && (
                    <span class="ml-2 text-amber-500">Required</span>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      </details>
    )}

    <div class="flex items-center gap-4 pt-1 font-mono text-[10px] text-zinc-600">
      <a
        href={patch.sourceUrl}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1 transition-colors hover:text-zinc-300"
      >
        <span>View source</span>
        <span aria-hidden="true">&nearr;</span>
      </a>
      <a href={`#${patch.id}`} class="transition-colors hover:text-zinc-300">
        Permalink
      </a>
    </div>
  </div>
</article>
