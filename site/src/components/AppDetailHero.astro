---
import AppIcon from './AppIcon.astro';
import type { App, Patch } from '../data/types';
import { getFallbackCategory, getFallbackSummary } from '../data/app-store';
import { formatAndroidVersion } from '../data/android-version';
import GooglePlayIcon from './icons/GooglePlayIcon.astro';

interface Props {
  app: App;
  patches: Patch[];
}

const { app, patches } = Astro.props;
const defaultCount = patches.filter((patch) => patch.default).length;
const configurableCount = patches.filter(
  (patch) => patch.options.length > 0,
).length;

const fallbackCategory = getFallbackCategory(app.id);
const fallbackSummary = getFallbackSummary(app.id);
const androidVersion = formatAndroidVersion(app.minSdk, '+');
---

<section
  data-hero-package={app.packageName}
  class="relative overflow-hidden border-y border-white/[0.08] bg-[#080808] p-5 sm:p-8"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-80"
    style={`background-image: radial-gradient(circle at 8% 12%, ${app.appIconColor}26, transparent 32%), linear-gradient(to right, transparent, rgba(255,255,255,0.015));`}
  ></div>
  <div class="pointer-events-none absolute inset-0 bg-technical-grid opacity-20"></div>

  <div class="relative flex flex-col gap-7 sm:flex-row sm:items-start">
    <AppIcon
      packageName={app.packageName}
      name={app.name}
      size={104}
      loading="eager"
      className="h-[104px] w-[104px] rounded-[22px] border border-white/15 bg-zinc-900 shadow-2xl shrink-0"
      fallbackClassName="rounded-[22px] text-3xl"
      fallbackColor={app.appIconColor}
    />
    <div class="min-w-0 flex-1">
      <div class="mb-2 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-zinc-500 leading-none pt-0.5">
        <span data-hero-category class="text-zinc-400 font-semibold">
          {fallbackCategory.name}
        </span>
      </div>

      <h1 class="font-sans text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {app.name}
      </h1>

      <p
        data-hero-summary
        class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-300"
      >
        {fallbackSummary}
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-2.5 font-mono text-xs">
        <a
          href="https://morphe.software/add-source?github=ihatenodejs/aidans-patches"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 rounded-sm bg-white px-4 py-2.5 font-semibold text-black transition-colors hover:bg-zinc-200"
        >
          <span>Add to Morphe</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <!-- View patches button removed per feedback -->
        <a
          href={app.playStoreUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 rounded-sm border border-white/[0.12] bg-zinc-900 px-4 py-2.5 text-zinc-300 transition-colors hover:border-white/25 hover:text-white"
        >
          <span class="h-3.5 w-3.5 text-zinc-400 shrink-0">
            <GooglePlayIcon />
          </span>
          <span>Google Play</span>
        </a>
      </div>
    </div>
  </div>

  <div class="relative mt-9 grid grid-cols-2 border border-white/[0.08] bg-black/25 sm:grid-cols-4 sm:divide-x sm:divide-white/[0.08]">
    <div class="border-b border-r border-white/[0.08] px-4 py-3.5 sm:border-b-0">
      <div class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">
        Compatible version
      </div>
      <div class="mt-1 truncate text-sm font-semibold text-zinc-200">
        {app.latestSupportedVersion}
      </div>
    </div>
    <div class="border-b border-white/[0.08] px-4 py-3.5 sm:border-b-0">
      <div class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">
        Package format
      </div>
      <div class="mt-1 text-sm font-semibold text-zinc-200">
        {app.apkFileType}
      </div>
    </div>
    <div class="border-r border-white/[0.08] px-4 py-3.5 sm:border-r-0">
      <div class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">
        Android
      </div>
      <div class="mt-1 text-sm font-semibold text-zinc-200">
        {androidVersion}
      </div>
    </div>
    <div class="px-4 py-3.5">
      <div class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">
        Included patches
      </div>
      <div class="mt-1 text-sm font-semibold text-zinc-200">
        {defaultCount} default · {configurableCount} configurable
      </div>
    </div>
  </div>
</section>
