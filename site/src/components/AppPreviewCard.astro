---
import AppIcon from './AppIcon.astro';
import type { App } from '../data/types';

interface Props {
  app: App;
  className?: string;
  loading?: 'lazy' | 'eager';
}

const { app, className = '', loading = 'lazy' } = Astro.props;
---

<a
  href={`/apps/${app.id}`}
  class={`group relative bg-[#090909] p-3.5 sm:p-5 hover:bg-white/[0.02] hover:shadow-[0_0_20px_rgba(255,255,255,0.06)] transition-[background-color,box-shadow] duration-150 flex flex-col justify-between ${className}`}
>
  <!-- Inset 1px hover highlight border (zero layout reflow, zero flickering) -->
  <div class="absolute inset-0 border border-transparent group-hover:border-white/35 pointer-events-none transition-colors duration-150"></div>
  <div class="flex items-center gap-3 mb-4 min-w-0">
    <AppIcon
      packageName={app.packageName}
      name={app.name}
      size={32}
      loading={loading}
      className="w-8 h-8 rounded-md border border-white/10 shrink-0 transition-transform group-hover:scale-105"
      fallbackClassName="rounded-md text-xs font-bold"
      fallbackColor={app.appIconColor}
    />
    <div class="min-w-0">
      <h4 class="font-sans text-sm font-semibold text-white truncate">
        {app.name}
      </h4>
      <span class="font-mono text-[10px] text-zinc-500 block truncate">
        {app.packageName}
      </span>
    </div>
  </div>

  <div class="pt-2 flex items-center justify-between text-xs font-mono">
    <div class="text-zinc-400 shrink-0">
      <span class="text-zinc-200 font-semibold">{app.patchCount}</span>
      <span class="text-zinc-500 text-[11px] ml-0.5">
        {app.patchCount === 1 ? 'patch' : 'patches'}
      </span>
    </div>

    <div class="flex items-center text-zinc-400 shrink-0">
      <span class="text-[10px] px-1.5 py-0.5 bg-white/[0.04] border border-white/[0.08] rounded-sm text-zinc-300">
        v{app.latestSupportedVersion}
      </span>
    </div>
  </div>
</a>
