---
interface Props {
  title?: string;
  badge?: string;
  className?: string;
}

const { title, badge, className = '' } = Astro.props;
---

<div
  class={`relative bg-[#080808] border border-white/[0.08] p-6 flex flex-col justify-between group hover:border-white/[0.16] transition-colors ${className}`}
>
  {(title || badge || Astro.slots.has('icon')) && (
    <div class="flex items-center justify-between gap-4 mb-4">
      {title && (
        <h3 class="font-sans text-sm font-semibold tracking-tight text-white flex items-center gap-2.5">
          <slot name="icon" />
          <span>{title}</span>
        </h3>
      )}
      {badge && (
        <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400 bg-white/[0.04] border border-white/[0.08] px-2 py-0.5 rounded-sm">
          {badge}
        </span>
      )}
    </div>
  )}

  <slot />
</div>
