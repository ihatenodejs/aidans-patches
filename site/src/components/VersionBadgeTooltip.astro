---
interface Props {
  text: string;
  badgeId?: string;
  className?: string;
}

const { text, badgeId, className = '' } = Astro.props;
---

<div class={`relative inline-flex items-center group/tooltip ${className}`}>
  <!-- Trigger Version Badge -->
  <span
    id={badgeId}
    data-app-version-badge
    tabindex="0"
    role="status"
    aria-label={`Target version ${text}`}
    class="relative z-10 inline-block px-1.5 py-0.5 font-mono text-[9px] font-semibold tracking-tight border bg-zinc-900 text-zinc-400 border-white/10 transition-colors cursor-help focus:outline-none focus-visible:ring-1 focus-visible:ring-white/40 select-none"
  >
    {text}
  </span>

  <!-- Tooltip popover: renders below badge with dual status badges -->
  <div
    data-tooltip-bubble
    role="tooltip"
    class="pointer-events-none absolute top-full right-0 mt-1.5 hidden w-max max-w-[260px] group-hover/tooltip:flex group-focus-within/tooltip:flex flex-col gap-1.5 z-50 rounded-sm border border-white/15 bg-black/95 p-2 shadow-2xl backdrop-blur-md transition-opacity duration-150"
  >
    <!-- Arrow pointing up to the badge -->
    <div
      class="absolute -top-1 right-2.5 h-1.5 w-1.5 rotate-45 border-t border-l border-white/15 bg-black/95"
      aria-hidden="true"
    ></div>

    <!-- Row 1: Compatibility Tests Status -->
    <div class="flex items-center justify-between gap-3 text-[10px] font-mono">
      <span class="text-zinc-500">Compatibility</span>
      <span
        data-tooltip-test-badge
        class="inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded-sm text-[9px] font-semibold bg-zinc-900 text-zinc-400 border border-white/10"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
        <span data-tooltip-test-label>Checking...</span>
      </span>
    </div>

    <!-- Row 2: Google Play Freshness / Latest Version -->
    <div class="flex items-center justify-between gap-3 text-[10px] font-mono pt-0.5">
      <span class="text-zinc-500">Latest Play</span>
      <span
        data-tooltip-play-badge
        class="inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded-sm text-[9px] font-semibold bg-zinc-900 text-zinc-400 border border-white/10"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
        <span data-tooltip-play-label>Checking...</span>
      </span>
    </div>
  </div>
</div>
