---
interface Props {
  targetRailId: string;
  ariaLabelPrefix: string;
}

const { targetRailId, ariaLabelPrefix } = Astro.props;
---

<div class="flex items-center gap-1">
  <button
    type="button"
    data-carousel-prev={targetRailId}
    aria-label={`${ariaLabelPrefix} - Previous`}
    class="flex h-7 w-7 items-center justify-center rounded-sm border border-white/10 bg-[#080808] text-zinc-400 transition-colors hover:border-white/25 hover:bg-zinc-900 hover:text-white disabled:pointer-events-none disabled:opacity-30 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/40"
  >
    <svg
      class="h-3.5 w-3.5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15 19l-7-7 7-7"
      ></path>
    </svg>
  </button>
  <button
    type="button"
    data-carousel-next={targetRailId}
    aria-label={`${ariaLabelPrefix} - Next`}
    class="flex h-7 w-7 items-center justify-center rounded-sm border border-white/10 bg-[#080808] text-zinc-400 transition-colors hover:border-white/25 hover:bg-zinc-900 hover:text-white disabled:pointer-events-none disabled:opacity-30 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/40"
  >
    <svg
      class="h-3.5 w-3.5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 5l7 7-7 7"
      ></path>
    </svg>
  </button>
</div>
