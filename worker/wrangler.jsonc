{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aidans-patches-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
  "vars": {
    "GITHUB_REPO": "ihatenodejs/aidans-patches",
  },
  "triggers": {
    "crons": ["0 */6 * * *", "15 0 * * *"],
  },
  "kv_namespaces": [
    {
      "binding": "PATCHES_KV",
      "id": "5c62cbcdc49749368cc3daba5aa87759",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PLAY_MEDIA",
      "bucket_name": "aidans-patches-play-media",
    },
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "worker.patch.p0ntus.com",
      "custom_domain": true,
    },
  ],
}
