{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apk-lab:benchmark:result:v1",
  "title": "APK Lab benchmark baseline result",
  "description": "Sanitized result contract for `apk-lab-migrate bench`. Commit only results whose source and inputs are sanitized; private corpora and source archives stay in ignored storage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "profile",
    "generatedAtEpochSeconds",
    "durationMs",
    "engine",
    "policy",
    "source",
    "environment",
    "settings",
    "measurements",
    "workloads",
    "acceptance",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "apk-lab-benchmark-result"
    },
    "status": {
      "enum": ["complete", "incomplete"]
    },
    "profile": {
      "enum": ["local"]
    },
    "generatedAtEpochSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "policy": {
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "environment": {
      "type": "object"
    },
    "settings": {
      "type": "object"
    },
    "measurements": {
      "$ref": "#/$defs/measurements"
    },
    "workloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workload"
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "reasons"],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableInteger": {
      "type": ["integer", "null"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "executable",
        "version",
        "argsPrefix",
        "directExecution",
        "uvInstallPerformed"
      ],
      "properties": {
        "name": {
          "const": "python"
        },
        "executable": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/nullableString"
        },
        "cwd": {
          "type": "string"
        },
        "argsPrefix": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "directExecution": {
          "const": true
        },
        "uvInstallPerformed": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "revision",
        "dirty",
        "worktreeDigest",
        "headIsExecutedSource",
        "warning",
        "archive"
      ],
      "properties": {
        "revision": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "worktreeDigest": {
          "$ref": "#/$defs/sha256"
        },
        "headIsExecutedSource": {
          "type": "boolean"
        },
        "warning": {
          "$ref": "#/$defs/nullableString"
        },
        "archive": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "location",
                "digest",
                "fileCount",
                "reconstruction"
              ],
              "properties": {
                "kind": {
                  "const": "private-source-archive"
                },
                "location": {
                  "type": "string"
                },
                "digest": {
                  "$ref": "#/$defs/sha256"
                },
                "fileCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "reconstruction": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "measurements": {
      "type": "object",
      "required": ["wall", "cpu", "descendantRss", "io"],
      "properties": {
        "wall": {
          "type": "object",
          "required": ["supported", "unit", "method"],
          "properties": {
            "supported": {
              "const": true
            },
            "unit": {
              "const": "milliseconds"
            },
            "method": {
              "type": "string"
            }
          }
        },
        "cpu": {
          "$ref": "#/$defs/metric"
        },
        "descendantRss": {
          "$ref": "#/$defs/metric"
        },
        "io": {
          "$ref": "#/$defs/metric"
        },
        "limitations": {
          "description": "Unsupported metrics derived from the pre-registered policy. A blocking entry is also present in acceptance.reasons; a non-blocking entry leaves sample values null and must be explained in cutover analysis.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/metricLimitation"
          }
        }
      }
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "required": ["supported", "unit", "method"],
          "properties": {
            "supported": {
              "const": true
            },
            "unit": {
              "enum": ["milliseconds", "bytes"]
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "sampler": {
              "description": "Explicit host sampling method identity; macOS ps and Linux /proc are distinct.",
              "enum": ["linux-proc", "macos-ps", "unsupported"]
            }
          }
        },
        {
          "$ref": "#/$defs/unsupportedMetric"
        }
      ]
    },
    "unsupportedMetric": {
      "type": "object",
      "required": ["supported", "unit", "reason"],
      "properties": {
        "supported": {
          "const": false
        },
        "unit": {
          "type": "null"
        },
        "method": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outputDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdoutExcerpt",
        "stderrExcerpt",
        "stdoutTruncated",
        "stderrTruncated"
      ],
      "properties": {
        "stdoutExcerpt": {
          "type": "string",
          "maxLength": 8192,
          "description": "Normalized observable stdout after private path redaction, bounded to 8192 characters."
        },
        "stderrExcerpt": {
          "type": "string",
          "maxLength": 8192,
          "description": "Normalized observable stderr after private path redaction, bounded to 8192 characters."
        },
        "stdoutTruncated": {
          "type": "boolean"
        },
        "stderrTruncated": {
          "type": "boolean"
        }
      }
    },
    "inputStatus": {
      "type": "object",
      "required": [
        "role",
        "declaredSha256",
        "actualSha256",
        "sizeBytes",
        "available",
        "displayPath",
        "reason"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "declaredSha256": {
          "$ref": "#/$defs/sha256"
        },
        "actualSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sizeBytes": {
          "$ref": "#/$defs/nullableInteger"
        },
        "available": {
          "type": "boolean"
        },
        "displayPath": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "sample": {
      "type": "object",
      "required": [
        "kind",
        "cacheState",
        "index",
        "wallMs",
        "cpuMs",
        "peakChildRssBytes",
        "readBytes",
        "writeBytes",
        "exitCode",
        "timedOut",
        "stdoutSha256",
        "stderrSha256",
        "rawStdoutSha256",
        "rawStderrSha256",
        "stdoutBytes",
        "stderrBytes",
        "outputValid",
        "outputsPinned",
        "outputNormalization",
        "validationErrors"
      ],
      "properties": {
        "kind": {
          "enum": ["warmup", "measured"]
        },
        "cacheState": {
          "enum": ["warmup", "warm-file-cache"]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "wallMs": {
          "type": "number",
          "minimum": 0
        },
        "cpuMs": {
          "$ref": "#/$defs/nullableNumber"
        },
        "peakChildRssBytes": {
          "$ref": "#/$defs/nullableInteger"
        },
        "readBytes": {
          "$ref": "#/$defs/nullableInteger"
        },
        "writeBytes": {
          "$ref": "#/$defs/nullableInteger"
        },
        "exitCode": {
          "$ref": "#/$defs/nullableInteger"
        },
        "timedOut": {
          "type": "boolean"
        },
        "stdoutSha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderrSha256": {
          "$ref": "#/$defs/sha256"
        },
        "rawStdoutSha256": {
          "description": "Stdout digest before any approved timing-only normalization.",
          "$ref": "#/$defs/sha256"
        },
        "rawStderrSha256": {
          "description": "Stderr digest before any approved timing-only normalization.",
          "$ref": "#/$defs/sha256"
        },
        "stdoutBytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderrBytes": {
          "type": "integer",
          "minimum": 0
        },
        "outputValid": {
          "type": "boolean"
        },
        "outputsPinned": {
          "type": "boolean"
        },
        "outputNormalization": {
          "description": "The exact approved normalization applied to this sample; null when no rule applies. Morphe workloads use only the timing-only test-case durationSeconds rule.",
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "validationErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "description": "Optional bounded, path-redacted stdout/stderr excerpts. Present only when outputValid is false for a sample that actually ran.",
          "$ref": "#/$defs/outputDiagnostics"
        }
      }
    },
    "wallSummary": {
      "type": "object",
      "required": ["count", "minMs", "medianMs", "meanMs", "p95Ms", "maxMs"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "minMs": {
          "type": "number"
        },
        "medianMs": {
          "type": "number"
        },
        "meanMs": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "maxMs": {
          "type": "number"
        }
      }
    },
    "workload": {
      "type": "object",
      "description": "A private-form workload carries argvTemplate; a sanitized-form workload carries the derived command object instead. Exactly one of the two is present.",
      "oneOf": [
        {
          "required": ["argvTemplate"]
        },
        {
          "required": ["command"]
        }
      ],
      "required": [
        "id",
        "category",
        "size",
        "costly",
        "status",
        "sampleClass",
        "warmupsExpected",
        "samplesExpected",
        "warmupsCompleted",
        "samplesCompleted",
        "reasons",
        "inputs",
        "mpp",
        "requiredTools",
        "environment",
        "samples",
        "summary",
        "outputValidation",
        "outputNormalization"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "startup",
            "inspection",
            "splits",
            "dex",
            "unity",
            "il2cpp",
            "resources",
            "code",
            "morphe"
          ]
        },
        "size": {
          "enum": ["small", "large"]
        },
        "costly": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "measured",
            "measured-unverified",
            "invalid-output",
            "incomplete"
          ]
        },
        "sampleClass": {
          "enum": ["local", "costly"]
        },
        "warmupsExpected": {
          "type": "integer",
          "minimum": 0
        },
        "samplesExpected": {
          "type": "integer",
          "minimum": 1
        },
        "warmupsCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "samplesCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputStatus"
          }
        },
        "mpp": {
          "oneOf": [
            {
              "$ref": "#/$defs/inputStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredTools": {
          "description": "Pinned APK Lab tool names this workload requires from the configured private tool cache.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "argvTemplate": {
          "description": "Private-form only: the raw argv from the local manifest. Removed by `bench --sanitize`, which derives `command` from it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "summary": {
          "oneOf": [
            {
              "$ref": "#/$defs/wallSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputValidation": {
          "type": "object",
          "required": [
            "stdoutHashPinned",
            "stderrHashPinned",
            "allOutputsValid"
          ],
          "properties": {
            "stdoutHashPinned": {
              "type": "boolean"
            },
            "stderrHashPinned": {
              "type": "boolean"
            },
            "allOutputsValid": {
              "type": "boolean"
            }
          }
        },
        "outputNormalization": {
          "description": "The approved normalization rule for this workload; null when no rule applies. Raw hashes are recorded separately on each sample.",
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "metricLimitations": {
          "description": "Unsupported metrics that forced this workload's sample values to stay null, with the policy consequence for each.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/metricLimitation"
          }
        }
      }
    },
    "command": {
      "description": "Sanitized-form only: derived deterministically from the private argvTemplate. `subcommand` is the first non-flag token (null when none); `flags` are every token starting with '-'; `flagNames` are those flags with any `=` value stripped. No semantics are inferred.",
      "type": "object",
      "additionalProperties": false,
      "required": ["subcommand", "flags", "flagNames"],
      "properties": {
        "subcommand": {
          "type": ["string", "null"]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flagNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metricLimitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "unit",
        "blocking",
        "requiresExplanation",
        "reason"
      ],
      "properties": {
        "metric": {
          "enum": ["cpu", "rss", "io"]
        },
        "unit": {
          "enum": ["milliseconds", "bytes"]
        },
        "blocking": {
          "type": "boolean"
        },
        "requiresExplanation": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": ["string", "null"],
          "description": "Optional recorded justification for accepting a non-blocking unsupported metric; plan008 must supply one before a cutover comparison relies on this limitation."
        }
      }
    }
  }
}
